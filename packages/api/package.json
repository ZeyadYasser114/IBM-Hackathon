{
  "name": "@mergemind/api",
  "version": "0.1.0",
  "description": "tRPC router — service layer connecting git-ingest, analysis, and verification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@mergemind/analysis": "workspace:*",
    "@mergemind/domain": "workspace:*",
    "@mergemind/git-ingest": "workspace:*",
    "@mergemind/verification": "workspace:*",
    "@trpc/server": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.4"
  }
}
