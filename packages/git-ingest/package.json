{
  "name": "@mergemind/git-ingest",
  "version": "0.1.0",
  "description": "Git repository ingestion — reads diffs, branches, and file contents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "import": "./dist/testing/builders.js",
      "types": "./dist/testing/builders.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/emit-cjs-marker.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "example": "tsc -p tsconfig.examples.json && node dist-examples/examples/ingest-example.js",
    "clean": "rm -rf dist dist-cjs *.tsbuildinfo"
  },
  "dependencies": {
    "@mergemind/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.4"
  }
}
