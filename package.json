{
  "name": "mergemind",
  "private": true,
  "version": "0.1.0",
  "description": "Semantic verification layer for parallel AI coding agents",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm --filter \"./apps/web\" dev",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck && pnpm -r --filter \"./apps/*\" typecheck",
    "lint": "pnpm -r --filter \"./packages/*\" lint && pnpm -r --filter \"./apps/*\" lint",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "clean": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
