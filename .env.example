# MergeMind — example environment configuration.
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# Every value below is a SAFE PLACEHOLDER. This file must never contain
# credentials, private tokens, personal information, or production data.
# The web app validates these variables at startup (see apps/web/src/lib/env.ts)
# and fails fast with a helpful message when one is invalid.

# Port for `pnpm dev` / `pnpm start` (1-65535). Defaults to 3000 when unset.
PORT=3000

# Set automatically by Vercel deployments. Leave unset locally.
# VERCEL_URL=

# IBM Bob inference (server-side ONLY — never expose these to the browser,
# never commit real values). When BOB_API_KEY is set, the API server runs
# Bob analysis agents and feeds their validated assumptions to the
# deterministic semantic engine. When unset, verification is deterministic-only.
# Create a key at bob.ibm.com → subscription instance → API Keys (Inference scope).
BOB_API_KEY=
# Full chat-completions base URL. Default: https://api.us-east.bob.ibm.com/inference/v1
# (official Bob host; override only if Bob docs specify otherwise).
# BOB_API_BASE_URL=
# Model alias. Default: premium (Bob Shell default alias).
# BOB_MODEL=
# Optional team ID header (required for General-scope keys, not Inference keys).
# BOB_TEAM_ID=
# Per-request inference timeout in ms. Default: 60000.
# BOB_TIMEOUT_MS=
