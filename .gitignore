# Dependencies
node_modules/
/.pnp
.pnp.js

# Production / Build
dist/
dist-cjs/
build/
out/
.next/

# Compiled output accidentally emitted next to sources breaks jest's
# relative module mapping (stale .js shadows the .ts source). Never commit.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

