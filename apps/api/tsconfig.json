{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mergemind/semantic-engine": ["../../packages/semantic-engine/src/index.ts"],
      "@mergemind/semantic-engine/*": ["../../packages/semantic-engine/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "../../packages/semantic-engine/src/**/*"
  ]
}
